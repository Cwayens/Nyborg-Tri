# Database (PostgreSQL, EU-region – fx Neon Frankfurt eller Supabase EU)
DATABASE_URL="postgresql://user:password@localhost:5432/nyborgtri"

# Auth.js – generér med: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Login-mails (magic link). SMTP fra fx Resend, Brevo eller Simply.com
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Nyborg Triathlon Klub <noreply@nyborgtri.dk>"

# Stripe (kort + MobilePay). Brug test-nøgler (sk_test_...) indtil go-live
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Første administrator (bruges af seed)
ADMIN_EMAIL="kasserer@nyborgtri.dk"

# Økonomisystem: "none" | "economic" | "dinero"
ACCOUNTING_PROVIDER="none"
# Token som økonomisystemet/kassereren bruger mod /api/v1/payments
ACCOUNTING_API_TOKEN=""

# e-conomic (kun hvis ACCOUNTING_PROVIDER=economic)
ECONOMIC_APP_SECRET_TOKEN=""
ECONOMIC_AGREEMENT_GRANT_TOKEN=""
ECONOMIC_JOURNAL_NUMBER="1"
ECONOMIC_REVENUE_ACCOUNT="1010"
ECONOMIC_CLEARING_ACCOUNT="5820"

# Kilde til import af det gamle indhold
WP_URL="https://www.nyborgtri.dk"

# Strava (Ure og apps). Opret app på https://www.strava.com/settings/api
# "Authorization Callback Domain" = dit domæne (fx www.nyborgtri.dk)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Valgfri tekst, bruges når Strava-webhook oprettes
STRAVA_VERIFY_TOKEN=""

# Testversion: "1" viser "Log ind som testbruger" og opretter 9 testbrugere med demodata.
# SKAL fjernes før siden går live.
DEMO_MODE=""
