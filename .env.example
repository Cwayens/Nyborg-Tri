# Database (PostgreSQL, EU-region – fx Neon Frankfurt eller Supabase EU)
DATABASE_URL="postgresql://user:password@localhost:5432/nyborgtri"
# Direkte forbindelse uden pooling til migrationer (Neon sætter den automatisk på Vercel)
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/nyborgtri"

# Auth.js – generér med: npx auth secret
AUTH_SECRET=""
# Sæt IKKE AUTH_URL i produktion: alle klubber kører fra samme installation på hver sit domæne,
# og adressen tages fra forespørgslen. Lokalt bruges http://localhost:3000 (Nyborg) og http://demo.localhost:3000.

# ---------- Platformen (flere klubber, se docs/ny-klub.md) ----------
# Platformens domæne: hver klub får <slug>.<PLATFORM_DOMAIN> (kræver et wildcard-domæne på Vercel)
PLATFORM_DOMAIN=""
# Klubben for ukendte adresser (fx Vercels preview-adresser) og den, som de gamle miljøvariabler herunder gælder for
DEFAULT_CLUB="nyborg"
# Krypterer de andre klubbers nøgler (Stripe, e-conomic m.m.) i databasen. Mindst 16 tegn. Gem den også uden for Vercel.
CLUB_SECRETS_KEY=""

# Login-mails (magic link). SMTP fra fx Resend, Brevo eller Simply.com. Én afsenderadresse for alle klubber;
# mailen får klubbens navn som afsender og klubbens mail som svar-til.
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="noreply@nyborgtri.dk"

# ---------- Standardklubbens egne indstillinger ----------
# Disse gælder KUN standardklubben (DEFAULT_CLUB). Andre klubber får deres egne med:
#   npm run klub -- noegle <slug> STRIPE_SECRET_KEY sk_live_...
# Stripe (kort + MobilePay). Brug test-nøgler (sk_test_...) indtil go-live
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Første administrator (bruges af seed)
ADMIN_EMAIL="kasserer@nyborgtri.dk"

# Økonomisystem: "none" | "economic" | "dinero"
ACCOUNTING_PROVIDER="none"
# Token som økonomisystemet/kassereren bruger mod /api/v1/payments
ACCOUNTING_API_TOKEN=""

# e-conomic (kun hvis ACCOUNTING_PROVIDER=economic)
ECONOMIC_APP_SECRET_TOKEN=""
ECONOMIC_AGREEMENT_GRANT_TOKEN=""
ECONOMIC_JOURNAL_NUMBER="1"
ECONOMIC_REVENUE_ACCOUNT="1010"
ECONOMIC_CLEARING_ACCOUNT="5820"

# Kilde til import af det gamle indhold
WP_URL="https://www.nyborgtri.dk"

# Strava (Ure og apps). Én app for hele platformen. Opret app på https://www.strava.com/settings/api
# "Authorization Callback Domain" = PLATFORM_DOMAIN (dækker alle <slug>.PLATFORM_DOMAIN). Webhooken oprettes én gang.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Valgfri tekst, bruges når Strava-webhook oprettes
STRAVA_VERIFY_TOKEN=""

# Testversion: "1" viser "Log ind som testbruger" og opretter testbrugere med demodata i standardklubben.
# En liste af klubber (fx "demo") gør det kun for dem, så rigtige klubber på platformen ikke får test-login.
# "1" SKAL fjernes, før siden går live.
DEMO_MODE=""

# TrainingPeaks API (kræver godkendt partneradgang). Uden dem importeres programmer som filer.
TRAININGPEAKS_CLIENT_ID=""
TRAININGPEAKS_CLIENT_SECRET=""

# Leaderboard og Mine tests: bedste præstationer udtrækkes fra Strava-data i små portioner,
# fordi Strava kun tillader ca. 1000 kald om dagen for hele klubben.
# Vercel sætter selv Authorization-headeren for cron-jobbet ud fra CRON_SECRET.
CRON_SECRET=""
EFFORTS_PER_RUN="80"
# Strava-data vises kun for medlemmet selv, medmindre Strava skriftligt har givet lov til klubbens leaderboard.
STRAVA_LEADERBOARD=""

# Hvor kontaktformularen sendes hen (standard: klubbens mail)
CONTACT_EMAIL=""

# Billeder og backup (Vercel Blob). Uden token gemmes billeder i databasen, og backup springes over.
BLOB_READ_WRITE_TOKEN=""
# Nøgle til kryptering af den natlige backup. Gem den også uden for Vercel, ellers kan backuppen ikke læses.
BACKUP_KEY=""
# Hvem får en mail, når siden fejler (kommasepareret)
ALERT_EMAIL=""

# Standardsprog: "da" (tomt) eller "en". Den besøgende kan altid skifte nederst på siden.
CLUB_LANG=""

# Standardklubbens identitet. Tomt = Nyborg Triathlon Klub. Andre klubber retter deres under Admin → Klubben.
CLUB_NAME=""
CLUB_SHORT_NAME=""
CLUB_LOGO_TOP=""
CLUB_LOGO_SUB=""
CLUB_LOGO_IMAGE=""
CLUB_TAGLINE=""
CLUB_EMAIL=""
CLUB_CVR=""
CLUB_BANK=""
CLUB_FACEBOOK=""
CLUB_DOMAIN=""
CLUB_CITY=""
CLUB_ZIP=""
# Farver som #rrggbb: knapper og links, mørk knapfarve, mørke flader, lys og sekundær klubfarve, telefonens topbjælke
CLUB_COLOR_ACCENT=""
CLUB_COLOR_ACCENT_DARK=""
CLUB_COLOR_DARK=""
CLUB_COLOR_LIGHT=""
CLUB_COLOR_SECOND=""
CLUB_COLOR_THEME=""
