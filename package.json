{
  "name": "nyborg-tri",
  "version": "0.1.0",
  "private": true,
  "description": "Hjemmeside og medlemssystem for Nyborg Triathlon Klub",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "import:wordpress": "tsx scripts/import-wordpress.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && (if [ \"$IMPORT_WP_ON_BUILD\" = \"1\" ]; then tsx scripts/import-wordpress.ts || echo \"WordPress-import fejlede\"; fi) && (if [ \"$DEMO_MODE\" = \"1\" ]; then tsx scripts/seed-demo.ts; fi) && next build",
    "db:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.19.3",
    "marked": "15.0.12",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.29",
    "nodemailer": "6.10.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "stripe": "18.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "prisma": "6.19.3",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
