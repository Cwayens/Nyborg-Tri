// Datamodel for Nyborg Triathlon Klub.
// Fase 1: medlemmer, medlemskaber, betalinger og indhold.
// Fase 2 (træningstilmelding) og fase 3 (TrainingPeaks) tilføjes som nye modeller
// uden at ændre de eksisterende – se docs/arkitektur.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrationer kører uden connection pooling (Neon sætter DATABASE_URL_UNPOOLED).
  // scripts/build.sh falder tilbage til DATABASE_URL, hvis den mangler.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Rettigheder: ATHLETE < TRAINER < ADMIN
enum Role {
  ATHLETE
  TRAINER
  ADMIN
}

// Atletgruppe – bestemmer hvilke træninger man ser i kalenderen
enum AthleteGroup {
  ELITE
  BREDDE
  BOERN
}

// ---------- Klubber (flere klubber i samme database) ----------

/// En klub på platformen. Alle andre tabeller (undtagen Account) har clubId, og src/lib/db.ts sørger for,
/// at en forespørgsel kun ser den aktuelle klubs rækker. Klubben findes ud fra domænet (src/lib/tenant.ts).
model Club {
  id        String   @id @default(cuid())
  slug      String   @unique // fx "nyborg"; giver adressen <slug>.<PLATFORM_DOMAIN>
  name      String
  domains   String[] @default([]) // egne domæner, fx ["nyborgtri.dk", "www.nyborgtri.dk"]
  secrets   String?  @db.Text // krypterede nøgler (Stripe, e-conomic m.fl.), se src/lib/club-secrets.ts
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users                    User[]
  sessions                 Session[]
  verificationTokens       VerificationToken[]
  membershipTypes          MembershipType[]
  memberships              Membership[]
  payments                 Payment[]
  pages                    Page[]
  posts                    Post[]
  postReactions            PostReaction[]
  trainingSessions         TrainingSession[]
  trainingSignups          TrainingSignup[]
  trialRequests            TrialRequest[]
  accessCodes              AccessCode[]
  wearableConnections      WearableConnection[]
  activitys                Activity[]
  groupWorkouts            GroupWorkout[]
  groupWorkoutParticipants GroupWorkoutParticipant[]
  efforts                  Effort[]
  benchmarkResults         BenchmarkResult[]
  chatMessages             ChatMessage[]
  sponsors                 Sponsor[]
  athleteProfiles          AthleteProfile[]
  contactPersons           ContactPerson[]
  contactMessages          ContactMessage[]
  mailLogs                 MailLog[]
  settings                 Setting[]
  buddyProfiles            BuddyProfile[]
  mentorships              Mentorship[]
  beginnerPlans            BeginnerPlan[]
  tips                     Tip[]
  challenges               Challenge[]
  challengeParticipants    ChallengeParticipant[]
  races                    Race[]
  raceEntrys               RaceEntry[]
  plannedWorkouts          PlannedWorkout[]
  clubRoutes               ClubRoute[]
  teams                    Team[]
  branchs                  Branch[]
  ledgerEntrys             LedgerEntry[]
  budgetLines              BudgetLine[]
}

// ---------- Brugere (Auth.js-modeller + medlemsoplysninger) ----------

model User {
  id            String        @id @default(cuid())
  clubId        String        @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club          Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  name          String?
  email         String // unik pr. klub
  emailVerified DateTime?
  image         String?
  role          Role          @default(ATHLETE)
  athleteGroup  AthleteGroup? // følger holdets type (se Team)
  teamId        String?
  team          Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  duties        Duty[]        @default([]) // ekstra roller ud over Role: kasserer og frivillig
  leads         Team[]        @relation("TeamLeaders") // hold, man er holdleder for

  phone     String?
  birthDate DateTime?
  gender    Gender?
  weightKg  Float? // til FTP i watt pr. kg; vises aldrig for andre

  // Forælder/værge for medlemmer under 18. Får betalingslink, kvitteringer og påmindelser.
  guardianName  String?
  guardianEmail String?
  address       String?
  zip           String?
  city          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  memberships              Membership[]
  payments                 Payment[]
  trainings                TrainingSession[]
  signups                  TrainingSignup[]
  trialRequest             TrialRequest?             @relation("TrialRequester")
  trialDecisions           TrialRequest[]            @relation("TrialDecider")
  codesCreated             AccessCode[]              @relation("CodeCreator")
  codeUsed                 AccessCode?               @relation("CodeUser")
  wearableConnections      WearableConnection[]
  activities               Activity[]
  groupWorkouts            GroupWorkout[]
  groupWorkoutParticipants GroupWorkoutParticipant[]
  benchmarks               BenchmarkResult[]
  chatMessages             ChatMessage[]
  efforts                  Effort[]
  athleteProfile           AthleteProfile?
  buddyProfile             BuddyProfile?
  mentorFor                Mentorship[]              @relation("Mentor")
  mentee                   Mentorship?               @relation("Mentee")
  beginnerPlan             BeginnerPlan?
  tips                     Tip[]
  challengesCreated        Challenge[]
  challenges               ChallengeParticipant[]
  racesCreated             Race[]
  raceEntries              RaceEntry[]

  shareActivities Boolean          @default(false) // samtykke: vis mine aktiviteter i klubstatistikken
  leaderboard     Boolean          @default(false) // samtykke: vis mine bedste præstationer på leaderboardet
  calendarToken   String?          @unique // hemmeligt link til kalender-abonnement
  newsMail        Boolean          @default(true) // vil have nyheder på mail (vigtige beskeder sendes altid)
  mentor          Boolean          @default(false) // frivillig mentor for nye medlemmer
  wantsMentor     Boolean          @default(false) // har ved indmeldelse bedt om en mentor; tildeles, når medlemmet har adgang
  deletedAt       DateTime? // kontoen er slettet; rækken er anonymiseret, men betalinger gemmes efter bogføringsloven
  plannedWorkouts PlannedWorkout[]
  postReactions   PostReaction[]
  ledgerEntries   LedgerEntry[]

  @@unique([clubId, email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  clubId       String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model VerificationToken {
  identifier String
  clubId     String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([clubId])
}

// ---------- Medlemskab og betaling ----------

model MembershipType {
  id          String  @id @default(cuid())
  clubId      String  @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club    @relation(fields: [clubId], references: [id], onDelete: Restrict)
  code        String // unik pr. klub // ADULT, YOUTH, PASSIVE
  name        String
  description String?
  priceOre    Int // pris i øre (1.000 kr = 100000)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  memberships Membership[]
  accessCodes AccessCode[]

  @@unique([clubId, code])
}

// Hvordan medlemskabet er opnået
enum MembershipSource {
  PAYMENT
  TRIAL // 14 dages prøveperiode godkendt af admin
  CODE // engangskode fra admin
  MANUAL
}

model Membership {
  id        String           @id @default(cuid())
  clubId    String           @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userId    String
  typeId    String
  startDate DateTime
  endDate   DateTime
  source    MembershipSource @default(PAYMENT)
  createdAt DateTime         @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  type    MembershipType @relation(fields: [typeId], references: [id])
  payment Payment?

  @@index([userId, endDate])
  @@index([clubId])
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum AccountingStatus {
  NOT_SENT
  SENT
  FAILED
  SKIPPED
}

model Payment {
  id                      String        @id @default(cuid())
  clubId                  String        @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club                    Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userId                  String
  membershipId            String?       @unique
  amountOre               Int
  currency                String        @default("DKK")
  description             String
  status                  PaymentStatus @default(PENDING)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  payToken                String?       @unique // hemmeligt betalingslink sendt til forælder/værge
  payLinkSentTo           String? // e-mail, betalingslinket blev sendt til
  typeId                  String? // medlemstypen, der betales for (bruges af betalingslinket)
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())

  // Synkronisering til økonomisystem
  accountingStatus AccountingStatus @default(NOT_SENT)
  accountingRef    String?
  accountingError  String?
  accountingSentAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@index([paidAt])
  @@index([clubId])
}

// ---------- Indhold ----------

enum ContentFormat {
  MARKDOWN
  HTML // importeret fra WordPress
}

model Page {
  id        String        @id @default(cuid())
  clubId    String        @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  path      String // unik pr. klub, fx "om/bestyrelse" – samme stier som den gamle side
  title     String
  body      String        @db.Text
  format    ContentFormat @default(MARKDOWN)
  published Boolean       @default(true)
  wpId      Int?
  updatedAt DateTime      @updatedAt

  @@unique([clubId, path])
  @@unique([clubId, wpId])
}

model Post {
  id            String         @id @default(cuid())
  clubId        String         @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club          Club           @relation(fields: [clubId], references: [id], onDelete: Restrict)
  slug          String // unik pr. klub; samme slug som på den gamle side, så gamle links virker
  title         String
  excerpt       String?
  body          String         @db.Text
  format        ContentFormat  @default(MARKDOWN)
  categories    String[]
  featuredImage String?
  images        String[]       @default([]) // flere billeder, vises som galleri og i historierne
  video         String? // link til YouTube eller Vimeo; afspilles først, når man trykker
  author        String?
  published     Boolean        @default(true)
  publishedAt   DateTime       @default(now())
  wpId          Int?
  updatedAt     DateTime       @updatedAt
  reactions     PostReaction[]

  @@unique([clubId, slug])
  @@unique([clubId, wpId])
  @@index([publishedAt])
}

/// Emoji-reaktion på en nyhed. Kun antal vises, ikke hvem, og der er ingen kommentarer (børn må kun skrive med børn og trænere).
model PostReaction {
  id        String   @id @default(cuid())
  clubId    String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@index([clubId])
}

// ---------- Træningskalender ----------

enum Discipline {
  SWIM
  BIKE
  RUN
  STRENGTH
  OTHER
}

model TrainingSession {
  id           String         @id @default(cuid())
  clubId       String         @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club         Club           @relation(fields: [clubId], references: [id], onDelete: Restrict)
  title        String
  description  String?        @db.Text
  discipline   Discipline
  location     String
  startsAt     DateTime
  endsAt       DateTime
  group        AthleteGroup // følger holdets type (se Team)
  teamId       String?
  team         Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  cancelledAt  DateTime? // aflyst af træner – vises i kalenderen i stedet for at forsvinde
  cancelReason String?
  seriesId     String? // fælles id for ugentligt gentagne træninger
  workout      Json? // struktureret program (fx fra TrainingPeaks), se src/lib/workout.ts
  paceGroups   String[]       @default([]) // tempogrupper, fx ["5:00 /km", "5:30 /km"]; tom = ingen
  testDay      BenchmarkTest? // fælles testdag: hvilken test der køres
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy User             @relation(fields: [createdById], references: [id])
  signups   TrainingSignup[]

  @@index([startsAt])
  @@index([group, startsAt])
  @@index([seriesId])
  @@index([clubId])
}

model TrainingSignup {
  id        String   @id @default(cuid())
  clubId    String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  sessionId String
  userId    String
  paceGroup String? // valgt tempogruppe
  createdAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([clubId])
}

// ---------- Adgang uden betaling ----------

enum TrialStatus {
  PENDING
  APPROVED
  REJECTED
}

// Ansøgning om 14 dages prøveperiode. Én pr. bruger.
model TrialRequest {
  id          String      @id @default(cuid())
  clubId      String      @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userId      String      @unique
  message     String?
  status      TrialStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  decidedAt   DateTime?
  decidedById String?

  user      User  @relation("TrialRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("TrialDecider", fields: [decidedById], references: [id])

  @@index([clubId])
}

// Engangskode der giver medlemskab af en bestemt type i et antal dage.
model AccessCode {
  id          String    @id @default(cuid())
  clubId      String    @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Restrict)
  code        String // unik pr. klub
  typeId      String
  days        Int
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  usedById    String?   @unique
  usedAt      DateTime?

  type      MembershipType @relation(fields: [typeId], references: [id])
  createdBy User           @relation("CodeCreator", fields: [createdById], references: [id])
  usedBy    User?          @relation("CodeUser", fields: [usedById], references: [id])

  @@unique([clubId, code])
}

// ---------- Wearables og aktiviteter ----------

enum Provider {
  STRAVA
  GARMIN
  POLAR
  SUUNTO
  COROS
  WAHOO
  TRAININGPEAKS
  MANUAL
}

model WearableConnection {
  id                String    @id @default(cuid())
  clubId            String    @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club              Club      @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userId            String
  provider          Provider
  externalAthleteId String
  accessToken       String    @db.Text
  refreshToken      String?   @db.Text
  expiresAt         DateTime?
  scope             String?
  connectedAt       DateTime  @default(now())
  lastSyncAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([clubId, provider, externalAthleteId])
  @@index([clubId])
}

model Activity {
  id         String     @id @default(cuid())
  clubId     String     @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club       Club       @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userId     String
  provider   Provider
  externalId String?
  sport      Discipline
  name       String
  startAt    DateTime
  movingSec  Int
  distanceM  Int        @default(0)
  elevationM Int        @default(0)
  avgHr      Int?
  hasPower   Boolean    @default(false) // wattmåler på cyklen
  effortsAt  DateTime? // hvornår bedste præstationer blev udtrukket (null = ikke endnu)
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  efforts Effort[]

  @@unique([clubId, provider, externalId])
  @@index([effortsAt])
  @@index([userId, startAt])
  @@index([startAt])
  @@index([clubId])
}

// ---------- Træn sammen ----------

// Medlemmer slår selv en træningstur op, som andre kan hoppe med på
model GroupWorkout {
  id          String     @id @default(cuid())
  clubId      String     @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club       @relation(fields: [clubId], references: [id], onDelete: Restrict)
  hostId      String
  discipline  Discipline
  title       String
  description String?    @db.Text
  location    String
  startsAt    DateTime
  durationMin Int        @default(60)
  level       String? // fx "rolig 6:00/km" eller "28-30 km/t"
  maxPeople   Int?
  workout     Json? // program, fx importeret fra TrainingPeaks (src/lib/workout.ts)
  createdAt   DateTime   @default(now())

  host         User                      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants GroupWorkoutParticipant[]
  planned      PlannedWorkout[]

  @@index([startsAt])
  @@index([clubId])
}

model GroupWorkoutParticipant {
  id        String   @id @default(cuid())
  clubId    String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout GroupWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
  @@index([clubId])
}

// ---------- Benchmarks (testresultater) ----------

enum BenchmarkTest {
  RUN_5K
  RUN_10K
  BIKE_FTP20 // gennemsnitlig watt over 20 minutter; FTP = 95 %
  SWIM_100
  SWIM_1500
  RUN_HALF // halvmaraton, kun leaderboard
  BIKE_40K // kun leaderboard
}

enum Gender {
  MALE
  FEMALE
}

/// Bedste præstation på en fast distance (eller 20 min watt) i én aktivitet fra et ur.
/// Udtrækkes automatisk, også når turen er længere end distancen (fx bedste 5 km i et 8 km-løb).
model Effort {
  id         String        @id @default(cuid())
  clubId     String        @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club       Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userId     String
  activityId String
  test       BenchmarkTest
  date       DateTime
  seconds    Int?
  watts      Int?
  createdAt  DateTime      @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  result   BenchmarkResult?

  @@unique([activityId, test])
  @@index([test, date])
  @@index([userId, test])
  @@index([clubId])
}

model BenchmarkResult {
  id        String        @id @default(cuid())
  clubId    String        @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userId    String
  test      BenchmarkTest
  date      DateTime
  seconds   Int? // tid for løb og svøm
  watts     Int? // for FTP-test
  note      String?
  source    Provider      @default(MANUAL)
  effortId  String?       @unique // præstationen fra uret, som resultatet blev gemt fra
  createdAt DateTime      @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  effort Effort? @relation(fields: [effortId], references: [id], onDelete: SetNull)

  @@index([userId, test, date])
  @@index([clubId])
}

// ---------- Chat ----------

// Voksne (Elite og Bredde) deler kanaler. Børn har deres egne, som trænerne følger.
enum ChatRoom {
  VOKSNE
  BOERN
}

enum ChatChannel {
  RUN
  BIKE
  SWIM
  SOCIAL
}

model ChatMessage {
  id          String      @id @default(cuid())
  clubId      String      @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)
  room        ChatRoom
  channel     ChatChannel
  userId      String
  body        String      @db.Text
  createdAt   DateTime    @default(now())
  deletedAt   DateTime? // slettet af afsender eller træner (moderation)
  deletedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([room, channel, createdAt])
  @@index([clubId])
}

/// Sponsorer i bjælken på forsiden. Admin redigerer under Administration > Sponsorer.
model Sponsor {
  id          String   @id @default(cuid())
  clubId      String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  name        String
  url         String?
  logo        String   @db.Text // sti i /public eller data-URL for uploadet logo
  description String? // kort tekst om sponsoren (offentlig)
  discount    String? // medlemsfordel, fx "10 % rabat i butikken" (offentlig)
  details     String?  @db.Text // adresse, rabatkode o.l. (kun for medlemmer)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  athletes AthleteProfile[]
  ledger   LedgerEntry[]

  @@index([clubId])
}

/// Offentlig profil på /atleter. Admin opretter og fremhæver; atleten skal give samtykke, før den vises.
model AthleteProfile {
  id        String    @id @default(cuid())
  clubId    String    @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userId    String    @unique
  slug      String // unik pr. klub
  headline  String? // fx "Ironman-atlet · AG 30-34"
  bio       String?   @db.Text
  goals     String?   @db.Text // mål for sæsonen, én pr. linje
  results   String?   @db.Text // resultater, én pr. linje
  photo     String?   @db.Text // data-URL
  instagram String?
  published Boolean   @default(false) // admin: vis på siden
  featured  Boolean   @default(false) // admin: fremhæv på forsiden
  sortOrder Int       @default(0)
  consentAt DateTime? // atletens samtykke; null = ikke givet / trukket tilbage
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsors Sponsor[]

  @@unique([clubId, slug])
}

// Kontaktpersoner på /om/kontakt (redigeres af admin)
model ContactPerson {
  id        String  @id @default(cuid())
  clubId    String  @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Restrict)
  role      String // fx "Formand"
  name      String
  phone     String?
  email     String?
  photo     String? @db.Text // data-URL
  sortOrder Int     @default(0)

  @@index([clubId])
}

// Henvendelser fra kontaktformularen
model ContactMessage {
  id        String    @id @default(cuid())
  clubId    String    @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Restrict)
  name      String
  email     String
  phone     String?
  topic     String?
  message   String    @db.Text
  createdAt DateTime  @default(now())
  handledAt DateTime?

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([clubId])
}

// Mails sendt til hold og medlemmer fra Admin → Mail
model MailLog {
  id         String   @id @default(cuid())
  clubId     String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  audience   String // fx "ALL", "GROUP:BOERN", "TRAINERS"
  kind       String // "NEWS" (kun dem der vil have nyheder) eller "IMPORTANT"
  subject    String
  body       String   @db.Text
  recipients Int
  failed     Int      @default(0)
  sentById   String
  sentByName String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([clubId])
}

// ---------- Funktioner der kan slås til og fra ----------

model Setting {
  key       String
  clubId    String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  value     Json
  updatedAt DateTime @updatedAt

  @@id([clubId, key])
}

// ---------- Bredden: makker, mentor, begynderforløb, tips, udfordringer og stævner ----------

// Frivillig makkerprofil, så medlemmer på samme niveau kan finde hinanden
model BuddyProfile {
  userId      String       @id
  clubId      String       @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  disciplines Discipline[]
  runPace     Int? // sekunder pr. km på en rolig tur
  bikeSpeed   Int? // km/t på en rolig tur
  swimPace    Int? // sekunder pr. 100 m
  times       String[] // MORGEN, DAG, AFTEN, WEEKEND
  note        String?
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model Mentorship {
  id        String    @id @default(cuid())
  clubId    String    @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Restrict)
  menteeId  String    @unique
  mentorId  String
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  mentee User @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor User @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([clubId])
}

model BeginnerPlan {
  userId    String   @id
  clubId    String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  startedAt DateTime
  done      String[] @default([]) // id'er på gennemførte pas, fx "u3-2"
  checklist String[] @default([]) // afkrydsede punkter på stævne-tjeklisten

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

model Tip {
  id          String      @id @default(cuid())
  clubId      String      @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)
  title       String
  body        String      @db.Text
  discipline  Discipline?
  videoUrl    String?
  authorId    String
  publishedAt DateTime    @default(now())

  author User @relation(fields: [authorId], references: [id])

  @@index([publishedAt])
  @@index([clubId])
}

enum ChallengeMetric {
  KM
  HOURS
  SESSIONS
}

model Challenge {
  id          String          @id @default(cuid())
  clubId      String          @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Restrict)
  title       String
  description String?
  discipline  Discipline? // null = alle sportsgrene
  metric      ChallengeMetric
  goal        Int
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  createdAt   DateTime        @default(now())

  createdBy    User                   @relation(fields: [createdById], references: [id])
  participants ChallengeParticipant[]

  @@index([clubId])
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  clubId      String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([clubId])
}

model Race {
  id          String   @id @default(cuid())
  clubId      String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  name        String
  date        DateTime
  location    String
  url         String?
  distances   String? // fx "Sprint, Olympisk"
  clubTent    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User        @relation(fields: [createdById], references: [id])
  entries   RaceEntry[]

  @@index([date])
  @@index([clubId])
}

enum RideRole {
  NONE
  DRIVER
  PASSENGER
}

model RaceEntry {
  id        String   @id @default(cuid())
  clubId    String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  raceId    String
  userId    String
  distance  String?
  ride      RideRole @default(NONE)
  seats     Int? // ledige pladser i bilen
  rideFrom  String? // fx "Nyborg station"
  createdAt DateTime @default(now())

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raceId, userId])
  @@index([clubId])
}

// Medlemmets egne planlagte træninger, importeret fra TrainingPeaks m.fl. Vises kun for medlemmet selv i kalenderen
// og kan deles til Træn sammen.
model PlannedWorkout {
  id          String     @id @default(cuid())
  clubId      String     @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club        Club       @relation(fields: [clubId], references: [id], onDelete: Restrict)
  userId      String
  day         String // "2026-12-01" (dansk dato)
  time        String? // "06:30", hvis kalenderfilen havde et klokkeslæt
  title       String
  discipline  Discipline
  durationMin Int?
  description String?    @db.Text
  workout     Json? // program fra .fit/.zwo/.mrc/.erg (src/lib/workout.ts)
  source      String // "fil", "kalender" eller "manuel"
  uid         String? // id fra kalenderfilen, så samme fil kan importeres igen uden dubletter
  sharedId    String? // Træn sammen-turen, hvis den er delt
  createdAt   DateTime   @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shared GroupWorkout? @relation(fields: [sharedId], references: [id], onDelete: SetNull)

  @@unique([userId, uid])
  @@index([userId, day])
  @@index([clubId])
}

// Klubbens ruter på kortet. Tom tabel = standardruterne i src/data/ruter.json. Admin kan tilføje ruter fra GPX-filer.
model ClubRoute {
  id        String // bruges i adressen /ruter/<id>; unik pr. klub
  clubId    String     @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club       @relation(fields: [clubId], references: [id], onDelete: Restrict)
  name      String
  sport     Discipline
  tag       String
  desc      String     @db.Text
  km        Float
  pts       Json // [[lat, lng], ...] forenklet til kortet
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@id([clubId, id])
}

// Klubbens hold, fx Elite, Bredde, Masters og Børn. Hvert hold har en type (kind), som styrer børnebeskyttelse,
// chatrum og standarder; athleteGroup på medlemmer og træninger holdes automatisk i trit med holdets type
// (databasetrigger i migrationen 20261125050000_hold).
model Team {
  id        String       @id @default(cuid())
  clubId    String       @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  name      String
  kind      AthleteGroup
  sees      String[]     @default([]) // andre hold, som holdets medlemmer kan se træninger for
  public    Boolean      @default(false) // besøgende, prøvemedlemmer og medlemmer uden hold ser holdets træninger
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  branchId  String?
  branch    Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  members   User[]
  leaders   User[]            @relation("TeamLeaders")
  trainings TrainingSession[]

  @@index([clubId])
}

/// Ekstra roller. Holdleder er ikke her, men på holdet (Team.leaders).
enum Duty {
  TREASURER // kasserer: betalinger, medlemstyper og medlemsliste
  VOLUNTEER // frivillig: på listen over frivillige og kan få mail som frivillig
}

/// Afdeling i et netværk (fx en by). Holdene hører til en afdeling; med kun én afdeling vises den ingen steder.
model Branch {
  id        String   @id @default(cuid())
  clubId    String   @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  name      String
  city      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  teams     Team[]

  @@index([clubId])
}

// ---------- Økonomi (kasserer og admin) ----------

enum LedgerKind {
  INCOME
  EXPENSE
}

/// En postering i klubbens regnskab, skrevet ind af kassereren. Kontingent betalt med kort kommer fra Payment og står ikke her.
model LedgerEntry {
  id           String     @id @default(cuid())
  clubId       String     @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club         Club       @relation(fields: [clubId], references: [id], onDelete: Restrict)
  voucherNo    Int // bilagsnummer, fortløbende pr. klub (se nextVoucherNo)
  date         DateTime   @db.Date
  kind         LedgerKind
  category     String // kode fra FINANCE_CATEGORIES i src/lib/finance.ts
  amountOre    Int // altid positivt; kind afgør retningen
  text         String
  counterparty String? // fx leverandør eller kommune
  sponsorId    String?
  sponsor      Sponsor?   @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  receipt      String?    @db.Text // billede eller PDF af bilaget
  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([clubId, voucherNo])
  @@index([date])
}

/// Budget pr. kategori og år
model BudgetLine {
  id        String @id @default(cuid())
  clubId    String @default("") // sættes af src/lib/db.ts; "" er ingen klub, så databasen afviser rækken
  club      Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)
  year      Int
  category  String
  amountOre Int

  @@unique([clubId, year, category])
  @@index([clubId])
}
