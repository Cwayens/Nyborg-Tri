// Datamodel for Nyborg Triathlon Klub.
// Fase 1: medlemmer, medlemskaber, betalinger og indhold.
// Fase 2 (træningstilmelding) og fase 3 (TrainingPeaks) tilføjes som nye modeller
// uden at ændre de eksisterende – se docs/arkitektur.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rettigheder: ATHLETE < TRAINER < ADMIN
enum Role {
  ATHLETE
  TRAINER
  ADMIN
}

// Atletgruppe – bestemmer hvilke træninger man ser i kalenderen
enum AthleteGroup {
  ELITE
  BREDDE
  BOERN
}

// ---------- Brugere (Auth.js-modeller + medlemsoplysninger) ----------

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  role          Role          @default(ATHLETE)
  athleteGroup  AthleteGroup?

  phone     String?
  birthDate DateTime?
  address   String?
  zip       String?
  city      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  memberships              Membership[]
  payments                 Payment[]
  trainings                TrainingSession[]
  signups                  TrainingSignup[]
  trialRequest             TrialRequest?             @relation("TrialRequester")
  trialDecisions           TrialRequest[]            @relation("TrialDecider")
  codesCreated             AccessCode[]              @relation("CodeCreator")
  codeUsed                 AccessCode?               @relation("CodeUser")
  wearableConnections      WearableConnection[]
  activities               Activity[]
  groupWorkouts            GroupWorkout[]
  groupWorkoutParticipants GroupWorkoutParticipant[]

  shareActivities Boolean @default(false) // samtykke: vis mine aktiviteter i klubstatistikken
  calendarToken   String? @unique // hemmeligt link til kalender-abonnement
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Medlemskab og betaling ----------

model MembershipType {
  id          String  @id @default(cuid())
  code        String  @unique // ADULT, YOUTH, PASSIVE
  name        String
  description String?
  priceOre    Int // pris i øre (1.000 kr = 100000)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  memberships Membership[]
  accessCodes AccessCode[]
}

// Hvordan medlemskabet er opnået
enum MembershipSource {
  PAYMENT
  TRIAL // 14 dages prøveperiode godkendt af admin
  CODE // engangskode fra admin
  MANUAL
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  typeId    String
  startDate DateTime
  endDate   DateTime
  source    MembershipSource @default(PAYMENT)
  createdAt DateTime         @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  type    MembershipType @relation(fields: [typeId], references: [id])
  payment Payment?

  @@index([userId, endDate])
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum AccountingStatus {
  NOT_SENT
  SENT
  FAILED
  SKIPPED
}

model Payment {
  id                      String        @id @default(cuid())
  userId                  String
  membershipId            String?       @unique
  amountOre               Int
  currency                String        @default("DKK")
  description             String
  status                  PaymentStatus @default(PENDING)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())

  // Synkronisering til økonomisystem
  accountingStatus AccountingStatus @default(NOT_SENT)
  accountingRef    String?
  accountingError  String?
  accountingSentAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@index([paidAt])
}

// ---------- Indhold ----------

enum ContentFormat {
  MARKDOWN
  HTML // importeret fra WordPress
}

model Page {
  id        String        @id @default(cuid())
  path      String        @unique // fx "om/bestyrelse" – samme stier som den gamle side
  title     String
  body      String        @db.Text
  format    ContentFormat @default(MARKDOWN)
  published Boolean       @default(true)
  wpId      Int?          @unique
  updatedAt DateTime      @updatedAt
}

model Post {
  id            String        @id @default(cuid())
  slug          String        @unique // samme slug som på den gamle side, så gamle links virker
  title         String
  excerpt       String?
  body          String        @db.Text
  format        ContentFormat @default(MARKDOWN)
  categories    String[]
  featuredImage String?
  author        String?
  published     Boolean       @default(true)
  publishedAt   DateTime      @default(now())
  wpId          Int?          @unique
  updatedAt     DateTime      @updatedAt

  @@index([publishedAt])
}

// ---------- Træningskalender ----------

enum Discipline {
  SWIM
  BIKE
  RUN
  STRENGTH
  OTHER
}

model TrainingSession {
  id           String       @id @default(cuid())
  title        String
  description  String?      @db.Text
  discipline   Discipline
  location     String
  startsAt     DateTime
  endsAt       DateTime
  group        AthleteGroup // hver træning er for præcis én gruppe
  cancelledAt  DateTime? // aflyst af træner – vises i kalenderen i stedet for at forsvinde
  cancelReason String?
  seriesId     String? // fælles id for ugentligt gentagne træninger
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy User             @relation(fields: [createdById], references: [id])
  signups   TrainingSignup[]

  @@index([startsAt])
  @@index([group, startsAt])
  @@index([seriesId])
}

model TrainingSignup {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

// ---------- Adgang uden betaling ----------

enum TrialStatus {
  PENDING
  APPROVED
  REJECTED
}

// Ansøgning om 14 dages prøveperiode. Én pr. bruger.
model TrialRequest {
  id          String      @id @default(cuid())
  userId      String      @unique
  message     String?
  status      TrialStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  decidedAt   DateTime?
  decidedById String?

  user      User  @relation("TrialRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("TrialDecider", fields: [decidedById], references: [id])
}

// Engangskode der giver medlemskab af en bestemt type i et antal dage.
model AccessCode {
  id          String    @id @default(cuid())
  code        String    @unique
  typeId      String
  days        Int
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  usedById    String?   @unique
  usedAt      DateTime?

  type      MembershipType @relation(fields: [typeId], references: [id])
  createdBy User           @relation("CodeCreator", fields: [createdById], references: [id])
  usedBy    User?          @relation("CodeUser", fields: [usedById], references: [id])
}

// ---------- Wearables og aktiviteter ----------

enum Provider {
  STRAVA
  GARMIN
  POLAR
  SUUNTO
  COROS
  WAHOO
  TRAININGPEAKS
  MANUAL
}

model WearableConnection {
  id                String    @id @default(cuid())
  userId            String
  provider          Provider
  externalAthleteId String
  accessToken       String    @db.Text
  refreshToken      String?   @db.Text
  expiresAt         DateTime?
  scope             String?
  connectedAt       DateTime  @default(now())
  lastSyncAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, externalAthleteId])
}

model Activity {
  id         String     @id @default(cuid())
  userId     String
  provider   Provider
  externalId String?
  sport      Discipline
  name       String
  startAt    DateTime
  movingSec  Int
  distanceM  Int        @default(0)
  elevationM Int        @default(0)
  avgHr      Int?
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId, startAt])
  @@index([startAt])
}

// ---------- Træn sammen ----------

// Medlemmer slår selv en træningstur op, som andre kan hoppe med på
model GroupWorkout {
  id          String     @id @default(cuid())
  hostId      String
  discipline  Discipline
  title       String
  description String?    @db.Text
  location    String
  startsAt    DateTime
  durationMin Int        @default(60)
  level       String? // fx "rolig 6:00/km" eller "28-30 km/t"
  maxPeople   Int?
  createdAt   DateTime   @default(now())

  host         User                      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants GroupWorkoutParticipant[]

  @@index([startsAt])
}

model GroupWorkoutParticipant {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout GroupWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
}
