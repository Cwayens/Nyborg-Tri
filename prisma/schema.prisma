// Datamodel for Nyborg Triathlon Klub.
// Fase 1: medlemmer, medlemskaber, betalinger og indhold.
// Fase 2 (træningstilmelding) og fase 3 (TrainingPeaks) tilføjes som nye modeller
// uden at ændre de eksisterende – se docs/arkitektur.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

// ---------- Brugere (Auth.js-modeller + medlemsoplysninger) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)

  phone     String?
  birthDate DateTime?
  address   String?
  zip       String?
  city      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  payments    Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Medlemskab og betaling ----------

model MembershipType {
  id          String  @id @default(cuid())
  code        String  @unique // ADULT, YOUTH, PASSIVE
  name        String
  description String?
  priceOre    Int // pris i øre (1.000 kr = 100000)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  memberships Membership[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  typeId    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  type    MembershipType @relation(fields: [typeId], references: [id])
  payment Payment?

  @@index([userId, endDate])
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum AccountingStatus {
  NOT_SENT
  SENT
  FAILED
  SKIPPED
}

model Payment {
  id                      String        @id @default(cuid())
  userId                  String
  membershipId            String?       @unique
  amountOre               Int
  currency                String        @default("DKK")
  description             String
  status                  PaymentStatus @default(PENDING)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())

  // Synkronisering til økonomisystem
  accountingStatus AccountingStatus @default(NOT_SENT)
  accountingRef    String?
  accountingError  String?
  accountingSentAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@index([paidAt])
}

// ---------- Indhold ----------

enum ContentFormat {
  MARKDOWN
  HTML // importeret fra WordPress
}

model Page {
  id        String        @id @default(cuid())
  path      String        @unique // fx "om/bestyrelse" – samme stier som den gamle side
  title     String
  body      String        @db.Text
  format    ContentFormat @default(MARKDOWN)
  published Boolean       @default(true)
  wpId      Int?          @unique
  updatedAt DateTime      @updatedAt
}

model Post {
  id            String        @id @default(cuid())
  slug          String        @unique // samme slug som på den gamle side, så gamle links virker
  title         String
  excerpt       String?
  body          String        @db.Text
  format        ContentFormat @default(MARKDOWN)
  categories    String[]
  featuredImage String?
  author        String?
  published     Boolean       @default(true)
  publishedAt   DateTime      @default(now())
  wpId          Int?          @unique
  updatedAt     DateTime      @updatedAt

  @@index([publishedAt])
}
